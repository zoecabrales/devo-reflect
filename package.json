{
  "name": "devo-reflect",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "emulators": "firebase emulators:start --project demo-devo-reflect",
    "deploy:firestore": "firebase deploy --only firestore:rules,firestore:indexes",
    "test": "jest --selectProjects unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-devo-reflect \"jest --selectProjects rules\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests"
  },
  "dependencies": {
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "^57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
