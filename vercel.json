{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders?slot=morning",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/reminders?slot=evening",
      "schedule": "0 12 * * *"
    }
  ]
}
